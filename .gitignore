# Python byte-code and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# IDE & Editor metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS generated files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary outputs & logs
*.log
scratch/
tmp/
