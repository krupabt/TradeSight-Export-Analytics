# ============================================================================
# TradeSight Export Analytics — Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# NEVER commit the real '.env' file to source control.
# ============================================================================

# Environment Mode: 'development' | 'staging' | 'production'
# In 'development', automated SMTP emails will be skipped safely.
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradesight_export_analytics
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# Reporting & Notifications (SMTP Alerting)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=alerts@tradesight-export.com
SMTP_PASSWORD=your_app_specific_password_here
REPORT_SENDER=alerts@tradesight-export.com
ALERT_RECIPIENTS=operations@tradesight-export.com,management@tradesight-export.com
